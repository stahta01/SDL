<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="libSDL3" />
		<Option makefile_is_custom="1" />
		<Option execution_dir="../../build-CB-msys-x86_64" />
		<Option pch_mode="2" />
		<Option default_target="testprocess" />
		<Option compiler="msys2_gcc" />
		<Build>
			<Target title="libSDL3">
				<Option output="../msys-SDL3" imp_lib="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).a" def_file="$(TARGET_OUTPUT_DIR)$(TARGET_OUTPUT_BASENAME).def" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="3" />
				<Option compiler="msys2_gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<MakeCommands>
					<Build command="$make -f $makefile all" />
					<CompileFile command="$make -f $makefile $file" />
					<Clean command="$make -f $makefile clean" />
					<DistClean command="$make -f $makefile distclean$target" />
					<AskRebuildNeeded command="$make -q -f $makefile all" />
					<SilentBuild command="$make -f $makefile all &gt; $(CMD_NULL)" />
				</MakeCommands>
			</Target>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="libSDL3;" />
		</VirtualTargets>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Unit filename="../../test/testprocess.c">
			<Option compilerVar="CC" />
			<Option target="testprocess" />
		</Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
