<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="test_posix_spawnp" />
		<Option pch_mode="2" />
		<Option compiler="msys2_gcc" />
		<Build>
			<Target title="msys_gcc_posix">
				<Option output="bin/Debug/test_posix_spawnp" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../../../build-CB-msys-x86_64" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="msys2_gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DSDL_PROCESS_POSIX" />
				</Compiler>
			</Target>
			<Target title="msys_gcc_win">
				<Option output="bin/Release/test_posix_win" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../../../build-CB-msys-x86_64" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="msys2_gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-DSDL_PROCESS_WINDOWS" />
					<Add option="-DSDL_PLATFORM_CYGWIN" />
					<Add option="-DSDL_PLATFORM_MSYS" />
				</Compiler>
			</Target>
			<Target title="ucrt64_gcc">
				<Option output="bin/ucrt64/test_ucrt64" prefix_auto="1" extension_auto="1" />
				<Option working_dir="../../../build-CB-msys-x86_64" />
				<Option object_output="obj/ucrt64/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-DSDL_PROCESS_WINDOWS" />
				</Compiler>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="../../../include" />
			<Add directory="../../../src" />
			<Add directory="../../include-config-relwithdebinfo/build_config" />
			<Add directory="../../../src/process" />
		</Compiler>
		<Linker>
			<Add library="libSDL3_test.a" />
			<Add library="libSDL3.a" />
			<Add library="iconv" />
			<Add library="ole32" />
			<Add library="gdi32" />
			<Add library="winmm" />
			<Add directory="../../../build-CB-msys-x86_64" />
		</Linker>
		<ExtraCommands>
			<Add before="pwd" />
		</ExtraCommands>
		<Unit filename="../../include-config-relwithdebinfo/build_config/SDL_build_config.h" />
		<Unit filename="SDL_posixprocess.c">
			<Option compilerVar="CC" />
			<Option target="msys_gcc_posix" />
		</Unit>
		<Unit filename="SDL_process.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="SDL_windowsprocess.c">
			<Option compilerVar="CC" />
			<Option target="msys_gcc_win" />
			<Option target="ucrt64_gcc" />
		</Unit>
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions />
	</Project>
</CodeBlocks_project_file>
